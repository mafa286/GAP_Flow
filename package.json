{
  "name": "GAP-Flow",
  "version": "1.2.5",
  "description": "Echtzeit GA-Prüfungs-Management-System mit automatisierter Gruppenzuteilung",
  "main": "server.ts",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "sqlite3": true,
    "esbuild": true
  },
  "scripts": {
    "start": "npm run build:frontend && npx tsx server.ts",
    "build:frontend": "npx tsc -p tsconfig.frontend.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "adm-zip": "^*",
    "express": "*",
    "express-rate-limit": "*",
    "socket.io": "*",
    "sqlite3": "*"
  },
  "devDependencies": {
    "@eslint/js": "*",
    "@types/adm-zip": "*",
    "@types/express": "*",
    "@types/node": "*",
    "@types/sqlite3": "*",
    "eslint": "*",
    "tsx": "*",
    "typescript": "*"
  }
}