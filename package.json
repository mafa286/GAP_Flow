{
  "name": "GAP-Flow",
  "version": "1.2.6",
  "description": "Echtzeit GA-Prüfungs-Management-System mit automatisierter Gruppenzuteilung",
  "main": "server.ts",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "sqlite3": true,
    "esbuild": true
  },
  "scripts": {
    "start": "npm run build:frontend && npx tsx server.ts",
    "build:frontend": "npx tsc -p tsconfig.frontend.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/sqlite3": "^3.1.11",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}