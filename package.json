{
  "name": "GAP-Flow",
  "version": "1.1.87",
  "description": "Echtzeit GA-Prüfungs-Management-System mit automatisierter Gruppenzuteilung",
  "main": "server.ts",
  "scripts": {
    "start": "npm run build:frontend && npx tsx server.ts",
    "build:frontend": "npx tsc -p tsconfig.frontend.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "socket.io": "^4.0.0",
    "sqlite3": "^6.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "eslint": "^9.10.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1"
  },
  "overrides": {
    "eslint-config-airbnb-base": {
      "eslint": "$eslint"
    },
    "brace-expansion": ">=2.0.1",
    "minimatch": ">=9.0.5"
  }
}